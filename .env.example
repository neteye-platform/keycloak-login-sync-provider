# Copy this file to .env, which is git-ignored (owned by plan 0002).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGEME
KC_SPI_AUTHENTICATOR__LOGIN_SYNC__SERVICE_ENDPOINT=http://mock-syncservice:8081/api/sync-user
# The operator must provision this realm, service-account client and secret; this stack provisions nothing.
KC_SPI_AUTHENTICATOR__LOGIN_SYNC__SA_CLIENT_ID=login-sync-sa
KC_SPI_AUTHENTICATOR__LOGIN_SYNC__SA_CLIENT_SECRET=CHANGEME
KC_SPI_AUTHENTICATOR__LOGIN_SYNC__SA_TOKEN_ENDPOINT=http://keycloak:8080/realms/CHANGEME_REALM/protocol/openid-connect/token
# Development-only: the stack uses plain HTTP for the mock receiver and token endpoint.
KC_SPI_AUTHENTICATOR__LOGIN_SYNC__ALLOW_INSECURE_HTTP=true
KC_SPI_AUTHENTICATOR__LOGIN_SYNC__HTTP_TIMEOUT_MS=5000
MOCK_PORT=8081
